<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen list widget: one to-do or shopping list, ticked off in place, with voice and typed add.
     The name (with ▾) changes the list; the actions float bottom-right so the name gets the whole header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">
        <!-- Margin's mark: opens the list in the app. -->
        <ImageView
            android:id="@+id/list_logo"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/list_widget_open"
            android:padding="11dp"
            android:src="@drawable/widget_logo" />
        <LinearLayout
            android:id="@+id/list_pick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/list_widget_change"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="2dp">
            <TextView
                android:id="@+id/list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/widget_chevron_down"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/list_widget_pick"
                android:textColor="@color/widget_ink"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/list_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- Bottom padding lets the last row scroll clear of the buttons. -->
        <ListView
            android:id="@+id/list_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="72dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="56dp"
            android:text="@string/list_widget_empty"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/list_voice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_soft_circle"
                android:contentDescription="@string/list_widget_voice"
                android:padding="13dp"
                android:src="@drawable/widget_mic" />
            <ImageView
                android:id="@+id/list_add"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_fab"
                android:contentDescription="@string/list_widget_add"
                android:padding="17dp"
                android:src="@drawable/widget_plus_on" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
