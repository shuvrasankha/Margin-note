<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: a voice command, a new note, a scan or a voice note straight away, or Passwords. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="voice_command" android:enabled="true" android:icon="@drawable/shortcut_voice_command"
        android:shortcutShortLabel="@string/shortcut_voice_command">
        <intent android:action="com.margin.app.VOICE_COMMAND"
            android:targetPackage="com.margin.note" android:targetClass="com.margin.app.ui.VoiceCommandActivity" />
    </shortcut>
    <shortcut android:shortcutId="new_note" android:enabled="true" android:icon="@drawable/shortcut_note"
        android:shortcutShortLabel="@string/shortcut_new_note">
        <intent android:action="com.margin.app.NEW_NOTE"
            android:targetPackage="com.margin.note" android:targetClass="com.margin.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="scan" android:enabled="true" android:icon="@drawable/shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent android:action="com.margin.app.SCAN"
            android:targetPackage="com.margin.note" android:targetClass="com.margin.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="voice" android:enabled="true" android:icon="@drawable/shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice">
        <intent android:action="com.margin.app.VOICE_NOTE"
            android:targetPackage="com.margin.note" android:targetClass="com.margin.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="passwords" android:enabled="true" android:icon="@drawable/shortcut_passwords"
        android:shortcutShortLabel="@string/shortcut_passwords">
        <intent android:action="com.margin.app.PASSWORDS"
            android:targetPackage="com.margin.note" android:targetClass="com.margin.app.MainActivity" />
    </shortcut>
</shortcuts>
